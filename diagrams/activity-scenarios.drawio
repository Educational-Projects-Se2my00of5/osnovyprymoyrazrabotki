                    </mxGeometry>
                </mxCell>
                <mxCell id="stats-6-2" value="• Название задачи&lt;br&gt;• Дедлайн&lt;br&gt;• Количество дней до дедлайна (при наведении на задачу в диаграмме)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=13;align=left;" parent="stats-row-6" vertex="1">

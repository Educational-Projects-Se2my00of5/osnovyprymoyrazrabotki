                <mxCell id="stats-5-2" value="• Список проектов со статусом каждого&lt;br&gt;• Количество задач в каждом проекте" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=13;align=left;" parent="stats-row-5" vertex="1">
                    <mxGeometry x="200" width="500" height="60" as="geometry">

                <mxCell id="stats-7-1" value="Цветовая индикация задач" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=13;fontStyle=1" parent="stats-row-7" vertex="1">

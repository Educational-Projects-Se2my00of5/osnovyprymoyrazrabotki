                    <mxGeometry width="200" height="80" as="geometry">
                        <mxRectangle width="200" height="80" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="stats-1-2" value="• Всего задач&lt;br&gt;• Выполнено&lt;br&gt;• В процессе&lt;br&gt;• Не начато&lt;br&gt;• Просрочено" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=13;align=left;" parent="stats-row-1" vertex="1">
